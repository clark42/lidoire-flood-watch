# Lidoire Flood Watch - environment template.
# Copy to .env and fill in every EMPTY secret below. NEVER commit .env
# (the repository is public).
#
# Secrets are deliberately left empty: docker compose refuses to start
# (":?" interpolation error) until POSTGRES_PASSWORD, INFLUXDB_ADMIN_PASSWORD,
# INFLUXDB_ADMIN_TOKEN and REDIS_PASSWORD are set, and the backend refuses
# to start when a secret is still a template placeholder such as "change-me".
#
# Generate each secret with:   openssl rand -hex 32
# (hex only: the Postgres/Redis passwords are embedded in connection URLs)
# e.g.   sed -i.bak "s/^API_KEY=$/API_KEY=$(openssl rand -hex 32)/" .env

# ---------------------------------------------------------------------------
# Network exposure (docker compose)
# ---------------------------------------------------------------------------
# Host address the frontend (3100) and backend (8100) ports are bound to.
# 127.0.0.1 = this machine only. Use 0.0.0.0 or a LAN IP to reach the
# dashboard from other devices, and then make sure API_KEY is set.
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# API security
# ---------------------------------------------------------------------------
# Required in the X-API-Key header for POST/PUT/PATCH/DELETE on /api/*.
# GET requests (dashboard, Netatmo OAuth callback) stay public.
# Empty = writes are unprotected (dev only, a warning is logged at startup).
# Set it whenever the dashboard is reachable from other machines:
#   API_KEY=$(openssl rand -hex 32)
# In the dashboard, the key is stored in the browser (localStorage "lfw_api_key").
API_KEY=

# Allowed CORS origins, comma-separated, no wildcard. FRONTEND_URL is added
# automatically. Same-origin access through nginx (port 3100) needs no CORS.
CORS_ORIGINS=http://localhost:3100,http://localhost:5173

# Public URL of the frontend, also used to build the Netatmo OAuth callback
# (<FRONTEND_URL>/api/auth/netatmo/callback must be registered on dev.netatmo.com)
FRONTEND_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# NOTE: POSTGRES_* are applied by the postgres image only when the volume is
# created. For an existing volume, change the password inside the database:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new>'"
POSTGRES_USER=postgres
# Required. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=lidoire_flood

# ---------------------------------------------------------------------------
# InfluxDB
# ---------------------------------------------------------------------------
INFLUXDB_ORG=lidoire
INFLUXDB_BUCKET=flood_data

# Init-only credentials (used by the influxdb container on its first start,
# NOT given to the backend). For an existing volume, keep the values that were
# used at setup time (previous default token: the INFLUXDB_TOKEN you had).
INFLUXDB_ADMIN_USER=admin
# Required. Generate each with: openssl rand -hex 32
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ADMIN_TOKEN=

# Backend token. Recommended: a token scoped to the bucket instead of the
# all-access admin token. Leave empty to fall back to INFLUXDB_ADMIN_TOKEN.
#   docker compose exec influxdb influx bucket list --org lidoire
#   docker compose exec influxdb influx auth create --org lidoire \
#     --read-bucket <bucket-id> --write-bucket <bucket-id> --description backend-rw
INFLUXDB_TOKEN=

# Optional read-only token for query paths (limits Flux injection impact):
#   docker compose exec influxdb influx auth create --org lidoire \
#     --read-bucket <bucket-id> --description backend-ro
# Empty = INFLUXDB_TOKEN is used for reads too.
INFLUXDB_READ_TOKEN=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Required. Generate with: openssl rand -hex 32
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Local development without docker (uvicorn --reload from backend/)
# docker compose overrides these three with the internal service addresses.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@localhost:5532/lidoire_flood
# INFLUXDB_URL=http://localhost:8186
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6479/0
# (ports published on 127.0.0.1 by a docker-compose.override.yml, see docker-compose.yml)

# Logging level for the backend (DEBUG, INFO, WARNING...)
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# External API keys (optional)
# ---------------------------------------------------------------------------
SHOM_API_KEY=
METEOFRANCE_API_KEY=
INFOCLIMAT_API_KEY=

# Netatmo API (for local weather station data)
# Create app at https://dev.netatmo.com/apps
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
NETATMO_ACCESS_TOKEN=

# Camera (RTSP URL may contain credentials: keep it in .env only)
CAMERA_RTSP_URL=
CAMERA_SNAPSHOT_INTERVAL=60

# Location - Moulin coordinates
MOULIN_LAT=44.8759811
MOULIN_LON=0.0015091

# Vigicrues stations
VIGICRUES_STATION_LIBOURNE=P577001001

# Tide ports
TIDE_PORT_BORDEAUX=BORDEAUX
TIDE_PORT_LIBOURNE=LIBOURNE

# Risk thresholds (defaults live in backend/app/config.py; uncomment to override)
# RISK_RAIN_24H_YELLOW=25
# RISK_RAIN_24H_ORANGE=40
# RISK_RAIN_24H_RED=60
# RISK_DORDOGNE_LEVEL_YELLOW=3.0
# RISK_DORDOGNE_LEVEL_ORANGE=3.8
# RISK_DORDOGNE_LEVEL_RED=4.5
# RISK_TIDE_COEF_HIGH=85
