# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lidoire_flood
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=lidoire
INFLUXDB_BUCKET=flood_data

# Redis
REDIS_URL=redis://localhost:6379

# API Keys (optional)
SHOM_API_KEY=
METEOFRANCE_API_KEY=
INFOCLIMAT_API_KEY=

# Netatmo API (for local weather station data)
# Create app at https://dev.netatmo.com/apps
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=

# Camera
CAMERA_RTSP_URL=rtsp://192.168.1.100:554/stream
CAMERA_SNAPSHOT_INTERVAL=60

# Location - Moulin coordinates
MOULIN_LAT=44.8759811
MOULIN_LON=0.0015091

# Vigicrues stations
VIGICRUES_STATION_LIBOURNE=O9720010

# Tide ports
TIDE_PORT_BORDEAUX=BORDEAUX
TIDE_PORT_LIBOURNE=LIBOURNE

# Risk thresholds
RISK_RAIN_24H_YELLOW=30
RISK_RAIN_24H_ORANGE=50
RISK_RAIN_24H_RED=80
RISK_DORDOGNE_LEVEL_YELLOW=3.0
RISK_DORDOGNE_LEVEL_ORANGE=4.0
RISK_DORDOGNE_LEVEL_RED=5.0
RISK_TIDE_COEF_HIGH=90

# Frontend
FRONTEND_URL=http://localhost:3000
